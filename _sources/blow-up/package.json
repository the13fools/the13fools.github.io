{
  "name": "blow-up",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "What is… a blowup? An interactive essay on resolution of singularities, from colliding balls to singular learning theory.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 4174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4174",
    "check:static": "node tools/check-site.mjs",
    "check": "npm run build && npm run check:static"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "katex": "^0.16.11"
  }
}
